import { fileURLToPath } from "node:url";
import { defineConfig } from "vitest/config";

// ============================================================
// پیکربندیِ آزمونِ فرانت‌اند
// ============================================================
// پروژه تا امروز هیچ آزمونی سمتِ Next نداشت و تنها دروازه‌هایش typecheck، lint و
// build بود — هیچ‌کدام رفتارِ زمان‌محور را نمی‌سنجند. حلقه‌ی پیگیریِ نتیجه‌ی
// پرداخت (OrderSuccessContent) تماماً دربارهٔ زمان است: هر ۱۵ ثانیه هشت بار، بعد
// هر ۶۰ ثانیه تا سقفِ ۴۰ بررسی، بعد توقف. یک اشتباه در همین اعداد یعنی مشتریِ
// پول‌داده تا ابد منتظر می‌ماند یا سرور بی‌دلیل درخواست می‌گیرد.
//
// چرا Vitest و نه چیزی سبک‌تر: کامپوننتِ تحتِ آزمون React است و JSX، تایمر و
// DOM می‌خواهد. `node:test` نه JSX را می‌فهمد و نه `document` دارد، پس برای
// آزمودنِ خودِ کامپوننت کافی نیست. Vitest فقط دو وابستگی می‌آورد (vitest و
// jsdom) و تایمرِ جعلی‌اش اجازه می‌دهد همان اعدادِ *تولیدی* سنجیده شوند:
// ۳۴ دقیقه‌ی واقعی در چند میلی‌ثانیه اجرا می‌شود و لازم نیست کدِ اصلی برای
// آزمون‌پذیرشدن ثابت‌هایش را تزریق‌پذیر کند.
//
// صراحتاً بدونِ @vitejs/plugin-react: esbuild خودِ Vite ترنسفورمِ JSX را با
// رانتایمِ خودکار انجام می‌دهد و آزمون به Fast Refresh نیازی ندارد. یک وابستگیِ
// کمتر برای پروژه‌ای که تا امروز هیچ ابزارِ آزمونی نداشته، مهم است.
export default defineConfig({
  // Vite این روزها به‌جای esbuild از oxc ترنسفورم می‌کند و گزینه‌ی `esbuild`
  // نادیده گرفته می‌شود. مهم‌تر: tsconfig پروژه `jsx: "preserve"` دارد (Next
  // خودش JSX را ترنسفورم می‌کند)، پس اگر دستی نگوییم، JSX دست‌نخورده به
  // مرورگرِ آزمون می‌رسد و با خطای «Unexpected JSX expression» می‌شکند.
  oxc: { jsx: { runtime: "automatic" } },

  // همان نامِ مستعارِ tsconfig («@/*» → «./src/*») تا importهای کامپوننت
  // بدونِ تغییر حل شوند.
  resolve: {
    alias: { "@": fileURLToPath(new URL("./src", import.meta.url)) },
  },

  test: {
    environment: "jsdom",
    environmentOptions: {
      // requestAnimationFrame می‌خواهیم: Toast برای ورودِ نرمِ خودش از آن
      // استفاده می‌کند و بدونش رندرِ توست در آزمون نیمه‌کاره می‌ماند.
      jsdom: { pretendToBeVisual: true },
    },
    include: ["src/**/*.test.{ts,tsx}"],
    clearMocks: true,
  },
});

# این فایل نمونه است و به گیت می‌رود. کپی‌اش کنید به .env و مقدارها را بگذارید:
#   cp .env.example .env      (یا در ویندوز: copy .env.example .env)

# مبدأِ Express برای fetchِ سمتِ سرور (SSR/SSG/Server Actions).
# عمداً NEXT_PUBLIC_ نیست: مرورگر نباید مستقیم به :3000 بزند، چون cross-origin
# می‌شود و Express نه CORS می‌دهد نه کوکیِ نشست را می‌پذیرد. درخواستِ مرورگر
# مسیرِ نسبی می‌رود و rewrites در next.config.ts آن را پروکسی می‌کند.
API_ORIGIN=http://localhost:3000

# آدرس عمومیِ سایت — پایه‌ی canonical، sitemap، robots و JSON-LD.
# در توسعه همان مبدأِ خودِ Next، در production دامنه‌ی واقعی با https.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------
# یادآوری برای سمتِ Express (در backend/.env):
#   CSRF_EXTRA_ORIGINS=http://localhost:3001
# بدونِ این، هر «نوشتن» از Next با ۴۰۳ رد می‌شود، چون مرورگر هدر
# Origin را با پورتِ Next می‌فرستد و Express آن را غریبه می‌بیند.
# ---------------------------------------------------------------

{
  "name": "polasco-goli-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:readme-counts": "node scripts/check-readme-counts.mjs",
    "test:watch": "vitest",
    "parity:storefront": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/parity-storefront.mjs",
    "legacy-links:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legacy-links-live.mjs",
    "freeze:oracle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/freeze-legacy-oracle.mjs",
    "cutover:rehearsal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cutover-rehearsal.mjs",
    "static-paths:live": "node scripts/static-paths-live.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.1",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.23",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.2"
  }
}

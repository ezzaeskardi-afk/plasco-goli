# این فایل رو کپی کنید به یک فایل به اسم «.env» در همین پوشه (backend/) و مقادیر واقعی رو جایگزین کنید.
# تا وقتی این مقدارها خالی باشن، سایت خودش رو می‌ندازه روی «حالت آزمایشی»
# (پرداخت واقعی انجام نمی‌شه ولی کل مسیر خرید قابل تست هست).

# کد پذیرندگی زرین‌پال (از پنل زرین‌پال بعد از ثبت کسب‌وکار)
ZARINPAL_MERCHANT_ID=

# ---------- پیامک ----------
# تا وقتی SMS_API_KEY خالی باشد، کد ورود فقط در کنسول سرور چاپ می‌شود (حالت آزمایشی).
# با پر کردن آن، ارسال واقعی فعال می‌شود — کد سمت سرور آماده است و نیازی به تغییر ندارد.

# کدام سرویس؟  kavenegar  یا  ippanel   (پیش‌فرض: kavenegar)
SMS_PROVIDER=kavenegar

# کلید API از پنل همان سرویس
SMS_API_KEY=

# نام الگوی «وریفای» که در پنل سرویس ساخته‌اید (کاوه‌نگار: template / ippanel: pattern code)
# متن الگو باید یک متغیر داشته باشد که کد ورود در آن قرار می‌گیرد.
SMS_OTP_TEMPLATE=login

# شماره‌ی خط ارسال — فقط برای پیامک «سفارش جدید» به مدیر لازم است (اختیاری)
SMS_SENDER=

# شماره موبایل مدیر فروشگاه — با ورود این شماره، «پنل مدیریت» فعال می‌شود
# (چند شماره را با ویرگول جدا کنید: 09113567409,09120000000)
ADMIN_PHONE=

# یک رشته‌ی تصادفی و طولانی برای امنیت نشست‌های کاربر (قبل از انتشار حتماً عوض کنید)
SESSION_SECRET=change-this-to-a-long-random-string

# وقتی سایت پشت HTTPS رفت (دامنه + SSL)، این را true کنید تا کوکی فقط روی HTTPS ارسال شود
COOKIE_SECURE=false

# ---------- پروکسی ----------
# اگر سایت پشت nginx یا کلادفلر اجرا می‌شود این را 1 کنید (یا تعداد لایه‌های پروکسی).
# با روشن بودنش، سرور آدرس واقعی کاربر را از هدر X-Forwarded-For می‌خواند.
# ⚠️ اگر سایت مستقیم روی اینترنت است، خاموش بگذارید: در آن حالت هر کسی می‌تواند این
# هدر را جعل کند و با هر درخواست یک «IP تازه» بسازد، یعنی همه‌ی محدودیت‌های نرخ —
# از جمله سقف روزانه‌ی پیامک که هزینه دارد — بی‌اثر می‌شود.
TRUST_PROXY=0

# پورتی که سرور روش اجرا می‌شه (اختیاری)
PORT=3000

# ---------- سئو ----------
# آدرس رسمی سایت. اگر خالی بماند، سرور از دامنه‌ی خودِ درخواست استفاده می‌کند
# که برای اجرای معمولی درست است. فقط وقتی لازم است پرش کنید که سایت پشت CDN یا
# پروکسی باشد و بخواهید canonical و sitemap همیشه روی یک دامنه‌ی مشخص باشد.
# مثال: SITE_URL=https://polascogoli.ir
SITE_URL=

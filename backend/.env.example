[TEMPLATE]
# این فایل فقط template است و نباید مقدار واقعی secret داخل آن قرار بگیرد.
# آن را به backend/.env کپی کنید و مقدارها را فقط روی همان سرور/سیستم محلی وارد کنید.
# backend/.env در Git ignore است و هرگز نباید commit یا برای کاربر ارسال شود.
# تا وقتی مقدارهای سرویس خالی باشند، سایت در حالت آزمایشی اجرا می‌شود.

# کد پذیرندگی زرین‌پال — فقط در backend/.env واقعی
ZARINPAL_MERCHANT_ID=

# ---------- پیامک ----------
SMS_PROVIDER=kavenegar
# کلید واقعی فقط در backend/.env واقعی یا secret manager سرویس انتشار
SMS_API_KEY=
SMS_OTP_TEMPLATE=login
SMS_SENDER=

# شماره موبایل مدیر — فقط در محیط امن سرور
ADMIN_PHONE=

# در production یک secret تصادفی حداقل ۳۲ کاراکتری وارد کنید.
# این placeholder را هرگز به‌عنوان مقدار واقعی استفاده نکنید.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# localhost: false | production پشت HTTPS: true
COOKIE_SECURE=false

# اگر سایت پشت nginx یا Cloudflare است تعداد لایه‌ها را تنظیم کنید؛ در اجرای مستقیم 0.
TRUST_PROXY=0

PORT=3000

# آدرس رسمی سایت برای canonical و sitemap.
#
# اگر فرانت‌اندِ Next را جلوی این سرور گذاشته‌اید (پیش‌فرض: http://localhost:3001)
# این مقدار را روی همان مبدأ بگذارید. غیر از canonical، آدرسِ بازگشتِ درگاه
# پرداخت هم از همین‌جا ساخته می‌شود (routes/orders.js) — خالی گذاشتنش یعنی
# مشتری وسطِ پرداخت از سایتِ Next بیرون می‌افتد و روی همین سرورِ Express
# تمام می‌کند.
#
# در production باید یک آدرسِ https باشد، وگرنه سرور بالا نمی‌آید (server.js:319).
SITE_URL=

# در production بهتر است لاگ در کنسول خاموش باشد و فقط فایل privacy-safe نوشته شود.
LOG_CONSOLE=false

# محدودیت‌ها و بکاپ (اختیاری)
API_RATE_LIMIT=300
WRITE_RATE_LIMIT=60
SMS_DAILY_CAP=300
BACKUP_DIR2=

# ---------------------------------------------------------------
# اجرای چندپروسه‌ای (Cluster)
# ---------------------------------------------------------------
# با true، به‌تعداد هسته‌های CPU پروسه‌ی worker بالا می‌آید و ترافیک بین‌شان
# پخش می‌شود. روی ویندوز خودکار خاموش می‌ماند (SQLite با cluster روی ویندوز
# مشکل دارد) و با یک هسته هم اثری ندارد.
#
# نکته‌ی مهم: شمارنده‌هایی که باید بین workerها مشترک باشند — سقف‌های نرخ، قفل
# حساب پس از رمزهای غلط، و توکن یک‌بارمصرفِ درخواست پیامک — با روشن‌شدن این
# گزینه خودکار به جدول‌های SQLite منتقل می‌شوند (lib/shared-state.js). پس نیازی
# به تنظیم دیگری نیست؛ فقط این را true کنید.
CLUSTER_ENABLED=false
# تعداد workerها؛ خالی یعنی به‌تعداد هسته‌ها
CLUSTER_WORKERS=

# ---------------------------------------------------------------
# مبدأهای اضافیِ مجاز برای درخواست‌های «نوشتن» — با کاما جدا کنید.
# ---------------------------------------------------------------
# سدِ دومِ CSRF در server.js هر POST/PUT/DELETE را که هدر Origin غریبه دارد رد
# می‌کند. وقتی frontendِ Next روی پورتِ دیگری (۳۰۰۱) نشسته و از rewrites به
# این سرور پروکسی می‌کند، مرورگر Origin را با پورتِ Next می‌فرستد و پروکسی
# همان را عبور می‌دهد — پس بدونِ این تنظیم، خرید و ورود ۴۰۳ می‌شوند.
#
# خالی بگذارید اگر Next و Express پشتِ یک دامنه‌اند (حالتِ production با nginx).
# فقط مبدأهایی را بنویسید که خودتان کنترل می‌کنید؛ هر مبدأی که اینجا بیاید
# اجازه‌ی نوشتن می‌گیرد.
CSRF_EXTRA_ORIGINS=

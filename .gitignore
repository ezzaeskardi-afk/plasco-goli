# ---------------------------------------------------------------
# چه چیزهایی داخل گیت نروند — پلاسکو گلی
#
# قاعده‌ی کلی: هر چیزی که «راز» است، «داده‌ی مشتری» است، یا خودکار
# دوباره ساخته می‌شود، اینجا می‌آید. باقی همه‌چیز باید نسخه‌بندی شود.
# ---------------------------------------------------------------

# --- رازها ---
# .env کلید درگاه پرداخت، کلید پیامک و SESSION_SECRET را دارد.
# اگر روزی این پروژه روی گیت‌هاب برود، لو رفتن این فایل یعنی کسی
# می‌تواند نشست‌ها را جعل کند. .env.example نسخه‌ی بی‌راز است و می‌ماند.
.env
.env.local
.env.*.local

# --- داده‌ی واقعی مشتری ---
# دیتابیس شماره‌ی موبایل، آدرس و پلاک مشتری‌ها را دارد. این هرگز
# نباید در تاریخچه‌ی گیت بنشیند: پاک‌کردنش از تاریخچه بعداً تقریباً
# غیرممکن است. پشتیبانِ دیتابیس کارِ backend/data/backups است، نه گیت.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/backups/
backend/data/*.bak
backend/data/.fuse_hidden*

# --- چیزهایی که خودکار ساخته می‌شوند ---
node_modules/
backend/logs/
*.log

# --- بکاپ‌های دستی ---
# از این به بعد کار برگرداندن با خود گیت انجام می‌شود، پس این ۱۰ مگابایت
# کپیِ کد لازم نیست وارد تاریخچه شود. پوشه سرجایش روی دیسک می‌ماند.
backup/
*.rar

# --- تنظیمات محلی ابزارها ---
# .claude تنظیمِ اجازه‌های همین دستگاه و آدرسِ سرورِ محلی است؛ به کارِ
# کسِ دیگری نمی‌آید و روی هر دستگاه فرق می‌کند.
.claude/
.freebuff/

# --- آشغال سیستم‌عامل و ویرایشگر ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
ui-ux-pro-max/
picture/products/raw-upload-*/
*.jfif
__pycache__/
